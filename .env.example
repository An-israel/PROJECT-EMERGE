# ---- Supabase (required) ----
# Found in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. NEVER expose to the browser. Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Seed admin (used by `pnpm seed`) ----
SEED_ADMIN_EMAIL=admin@ideallifecity.org
SEED_ADMIN_PASSWORD=change-me-please

# ---- Email via Resend (optional; app degrades gracefully without it) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=Project Emerge <no-reply@ideallifecity.org>

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
